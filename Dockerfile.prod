# Dockerfile específico para producción en AWS
FROM python:3.13-slim

# Variables de build
ARG DEBIAN_FRONTEND=noninteractive

# Instalar dependencias del sistema
RUN apt-get update && apt-get install -y \
    pkg-config \
    default-libmysqlclient-dev \
    build-essential \
    curl \
    nginx \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Establecer directorio de trabajo
WORKDIR /app

# Copiar requirements e instalar dependencias Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install gunicorn

# Copiar código de aplicación
COPY . .

# Recolectar archivos estáticos
RUN python manage.py collectstatic --noinput --clear

# Configurar nginx sin privilegios root
COPY deploy/nginx.conf /etc/nginx/nginx.conf

# Configurar supervisor
COPY deploy/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Crear usuario no-root
RUN adduser --disabled-password --gecos '' appuser

# Crear directorios temporales para nginx
RUN mkdir -p /tmp/nginx_client_temp /tmp/nginx_proxy_temp /tmp/nginx_fastcgi_temp \
    /tmp/nginx_uwsgi_temp /tmp/nginx_scgi_temp /var/log/gunicorn

# Cambiar propietario de directorios necesarios
RUN chown -R appuser:appuser /app && \
    chown -R appuser:appuser /var/log/gunicorn && \
    chown -R appuser:appuser /tmp/nginx_*

USER appuser

# Exponer puerto 80
EXPOSE 80

# Comando de inicio con supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]