{
  "id": "production-chatbot-env",
  "name": "Lannister ChatBot - Production",
  "values": [
    {
      "key": "base_url",
      "value": "https://your-production-domain.com",
      "type": "default",
      "enabled": true
    },
    {
      "key": "session_id",
      "value": "prod-session-{{$randomUUID}}",
      "type": "default",
      "enabled": true
    },
    {
      "key": "api_token",
      "value": "your-production-api-token",
      "type": "secret",
      "enabled": true
    }
  ],
  "_postman_variable_scope": "environment"
}
