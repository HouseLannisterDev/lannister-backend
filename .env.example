# =========================
# Django Core - PRODUCCIÓN AWS
# =========================
DJANGO_SECRET_KEY=tu_secreto_super_seguro_aqui_cambiar_en_produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=tu-dominio.com,tu-ip-elastica.amazonaws.com,localhost
DJANGO_TIME_ZONE=America/Sao_Paulo
SESSION_COOKIE_AGE=604800
SESSION_COOKIE_DOMAIN=.tu-dominio.com
SESSION_COOKIE_SECURE=True

# =========================
# Database - RDS MySQL (São Paulo)
# =========================
MYSQL_DB=lannister_news
MYSQL_USER=admin
MYSQL_PASSWORD=tu_password_rds_aqui
MYSQL_HOST=database-1.cpcimk2ikn91.sa-east-1.rds.amazonaws.com
MYSQL_PORT=3306

# =========================
# Redis - ElastiCache AWS
# =========================
REDIS_URL=redis://tu-redis-cluster.cache.amazonaws.com:6379/1

# =========================
# MongoDB Atlas (externo)
# =========================
MONGO_NAME=lannister_news
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/lannister_news?retryWrites=true&w=majority

# =========================
# AWS Configuration
# =========================
AWS_DEFAULT_REGION=sa-east-1
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key

# ==========================
# Scraping
# ==========================
NEWS_SOURCES=espn.com,marca.com,as.com,goal.com,eltiempo.com,elespectador.com,bbc.com,cnn.com,nytimes.com,lavanguardia.com,vogue.com,elle.com,harpersbazaar.com,techcrunch.com,thenextweb.com,wired.com,xataka.com,nationalgeographic.com,animalpolitico.com
NEWS_REQ_DELAY_MIN=3
NEWS_REQ_DELAY_MAX=8
NEWS_MAX_RETRIES=3

# Proxies opcionales (vacío = no usar)
NEWS_PROXIES=

# Opcional override UAs (coma-separado)
NEWS_USER_AGENTS=

# ==========================
# Chatbot
# ==========================
FAQ_MODEL_PATH=chatbot/faq_model_2
FAQ_PATH=./chatbot/faqs/faqs.json
FAQ_NORMALIZED_PATH=./chatbot/faqs/faqs_normalized.json

# Failover chatbot
FALLOVER_THRESHOLD=0.35
FALLOVER_MESSAGE=Lo siento, no puedo responder esa pregunta.
